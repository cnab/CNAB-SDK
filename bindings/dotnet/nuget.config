<?xml version="1.0" encoding="utf-8"?>
<!--
  Resolves Cnab.Core from the local pacmak output instead of nuget.org, which is
  the point: these tests must run against the package built from THIS commit.

  Committed rather than done with `dotnet nuget add source` in CI because that
  command mutates the machine-global NuGet config and fails outright if a source
  with the same name already exists — fine on a throwaway runner, hostile on a
  developer machine and on any re-run. A repo-local nuget.config is idempotent
  and makes `dotnet test` work here with no setup.

  `clear` drops inherited sources so a stale Cnab.Core on nuget.org could never
  satisfy the reference by accident; nuget.org is then re-added by name for
  xunit and the test SDK.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="cnab-local" value="../../packages/core/dist/dotnet" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
