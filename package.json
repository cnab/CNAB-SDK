{
  "name": "cnab-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Modern multi-language SDK for Brazilian CNAB 240/400 bank files",
  "license": "MIT",
  "workspaces": [
    "packages/spec",
    "packages/core",
    "packages/cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:spec": "node tools/build-spec.mjs && node tools/embed-spec.mjs",
    "build:core": "npm run build --workspace @cnab/core",
    "build": "npm run build:spec && npm run build:core",
    "test": "npm run build:spec && node tools/check-packaging.mjs && npm run test --workspaces --if-present",
    "check:packaging": "node tools/check-packaging.mjs --pack",
    "report:spec": "node tools/spec-report.mjs",
    "docs": "typedoc",
    "docs:serve": "npx --yes http-server site -p 8080"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "js-yaml": "^4.1.0",
    "typedoc": "^0.26.11"
  }
}
