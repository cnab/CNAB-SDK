node_modules/
dist/
lib/
site/
*.tsbuildinfo
.jsii
# Build output, generated by tools/embed-spec.mjs from packages/spec/dist/spec.json.
# Not committed: it is a ~300 KB verbatim copy of generated data that would churn
# in full on every catalog change. Every build path regenerates it (root
# `build:spec`, core's `build`/`build:jsii`, and therefore `prepack`).
packages/core/src/spec.generated.ts
tsconfig.tsbuildinfo
coverage/
*.log
.DS_Store
# Staging dir + notes built by the `release` job in .github/workflows/release.yml.
# Also created when dry-running those steps locally.
artifacts/
RELEASE_NOTES.md
*.tgz
# Per-language binding test build output. Scoped to bindings/ on purpose:
# an unanchored `bin/` would swallow packages/cli/bin/, which is tracked and is
# the CLI's published entry point.
bindings/java/target/
bindings/dotnet/bin/
bindings/dotnet/obj/
__pycache__/
*.pyc
.pytest_cache/
# Git worktrees created for parallel agents. Each is a FULL checkout of this
# repo (~150 MB, ~5k files apiece), so an unignored one shows up as thousands of
# untracked files and invites exactly the wrong reflex: `git add -A`. Scoped to
# worktrees/ rather than all of .claude/ so project-level config such as
# .claude/settings.json can still be committed if this repo ever wants it.
.claude/worktrees/

# Bank layout manuals: fetched on demand, never committed.
# node tools/fetch-layouts.mjs
.layouts/
